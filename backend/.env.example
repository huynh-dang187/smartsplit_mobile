# ==============================================================================
# SMARTSPLIT BACKEND - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy.
# Khi deploy lên Render.com: Cấu hình các biến này trong phần "Environment Variables" của Web Service.

# 1. Cổng lắng nghe của Backend Server (Render tự gán biến PORT hoặc mặc định 3000 khi chạy local)
PORT=3000

# 2. Chuỗi kết nối MongoDB Atlas (Đảm bảo đã whitelist IP 0.0.0.0/0 trên MongoDB Atlas để Render truy cập được)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/smartsplit?retryWrites=true&w=majority

# 3. Khóa Google Gemini API & Model (Mặc định: gemini-3.6-flash bóc tách ảnh hóa đơn qua Google GenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 4. Chuỗi bí mật ký JSON Web Token (JWT) để bảo mật phiên đăng nhập người dùng
JWT_SECRET=your_super_secret_jwt_key_here
