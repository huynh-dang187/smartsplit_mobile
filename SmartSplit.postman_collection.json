  "item": [
    {
      "name": "1. Auth & User Profile",
      "item": [
        {
          "name": "1.1 Đăng ký (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "        console.log('Token updated from Register');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Huỳnh Đăng\",\n  \"email\": \"dang@gmail.com\",\n  \"password\": \"Password123!\",\n  \"bankInfo\": {\n    \"bankBin\": \"970436\",\n    \"bankShortName\": \"Vietcombank\",\n    \"accountNo\": \"1012345678\",\n    \"accountName\": \"HUYNH DANG\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "1.2 Đăng nhập (Login)",
          "event": [
